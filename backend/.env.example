DATABASE_URL="postgresql://user:password@localhost:5432/netflix_mouvement?schema=public"
# Obligatoire, 32 caractères minimum. Générer avec : openssl rand -base64 48
JWT_SECRET=""
PORT=3000
NODE_ENV="development"

# Domaine du site (redirections Stripe + seule origine autorisée par CORS)
FRONTEND_URL="http://localhost:4200"
# Domaines supplémentaires autorisés par CORS, séparés par des virgules (optionnel)
CORS_ORIGINS=""

GOOGLE_CLIENT_ID=""

# Stripe (https://dashboard.stripe.com/apikeys et Webhooks)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudflare Stream (voir https://dash.cloudflare.com/ > Stream)
CLOUDFLARE_ACCOUNT_ID="ton_account_id"
CLOUDFLARE_STREAM_API_TOKEN="ton_api_token_avec_permission_stream_edit"
